# Run: python3 scripts/init_env.py
# The script fills empty development secrets; never commit .env.
APP_ENV=development
DEV_API_TOKEN=
DATABASE_URL=sqlite:///./.data/dev.db
POSTGRES_DB=threat_intel
POSTGRES_USER=threat_intel
POSTGRES_PASSWORD=
WEB_PORT=8080
WORKER_POLL_SECONDS=2
# Reserved setting; supported assessment releases are defined in backend/assessment/contracts.py.
SUPPORTED_UBUNTU_RELEASE=
# Optional school API connection; no remote request at startup or when browsing results.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2200
# Optional: NVD permits unauthenticated queries with a lower request rate.
NVD_API_KEY=
# Exact IP:port allowlist; IPv6 uses [address]:port. Empty disables new SSH requests.
SSH_ALLOWED_TARGETS=
SSH_KEY_DIRECTORY=.data/ssh-keys
SSH_KEY_PASSWORD=
SSH_TIMEOUT_SECONDS=45
# Downloaded authenticated package artifacts are bounded; put this on a roomy data drive.
PACKAGE_CACHE_DIRECTORY=.data/package-cache
PACKAGE_CACHE_MIB=768
GPG_BINARY=
AUTH_MODE=token
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false
